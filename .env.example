# ==============================================================================
# SkillBridge AI - Environment Configuration Template (.env.example)
# IMPORTANT: Copy this file to '.env' and populate with your local values.
# NEVER commit actual passwords, secrets, or API keys to version control.
# ==============================================================================

# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="SkillBridge AI"
API_V1_STR=/api/v1

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY=change_in_production_minimum_32_characters_secret_key_skillbridge_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (MySQL Community Edition / MariaDB or SQLite for zero-setup local dev)
# Format for MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://skillbridge_user:skillbridge_dev_pass@localhost:3306/skillbridge_db
# Alternative for isolated local testing without running MySQL server:
# DATABASE_URL=sqlite:///./skillbridge_dev.db

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# CORS & Allowed Origins (JSON list or comma-separated list of origins)
# Include local Flutter Web ports and remote hosting domains
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8080"]

# Host & Port Binding (FastAPI / Uvicorn)
HOST=0.0.0.0
PORT=8000

# Adaptive AI Learning Engine Configuration
AI_ADAPTIVE_ENGINE_ENABLED=true
DEFAULT_MASTERY_THRESHOLD=0.75
MINIMUM_QUESTIONS_PER_ASSESSMENT=5

# Optional LLM / Future Extension Keys (Leave blank or unset in Part 1)
LLM_PROVIDER=none
LLM_API_KEY=
