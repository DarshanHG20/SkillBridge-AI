# ==============================================================================
# SkillBridge AI - Unified Environment Configuration Template (.env.example)
# Architecture: Hybrid MERN (Node.js + Express + MongoDB + React Vite) + Flutter
# IMPORTANT: Never commit real passwords, JWT secrets, or LLM API keys.
# See sub-project templates:
#   - backend-node/.env.example (Active Main API Backend, port 5000)
#   - frontend/.env.example     (React + Vite Web Frontend, port 5173)
#   - backend/.env.example      (Preserved Legacy Python FastAPI Backend, port 8000)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Active Main Backend (backend-node/ - Node.js + Express + MongoDB)
# ------------------------------------------------------------------------------
NODE_ENV=development
PROJECT_NAME="SkillBridge AI"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=5000

# Security & Authentication (Generate strong 32+ char key for production)
JWT_SECRET=replace_this_with_a_secure_minimum_32_characters_secret_key_skillbridge_2026
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=7

# MongoDB Connection (Local MongoDB + optional MongoMemoryServer dev fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge_db
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/skillbridge_db_test
USE_MEMORY_DB_FALLBACK=true

# Preserved SQLite Source (for scripts/migrate_sql_to_mongo.js)
SQLITE_DB_PATH=../backend/skillbridge_dev.db

# CORS Allowed Origins (Comma-separated list; enforced strictly in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 2. React Web Frontend (frontend/) & Flutter Clients (mobile_app/, admin_dashboard/)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Flutter Mobile Emulator default: http://10.0.2.2:5000/api/v1
# Flutter Physical Device LAN IP:  --dart-define=API_BASE_URL=http://<COMPUTER_LAN_IP>:5000/api/v1
# Flutter Admin Web Console:       --dart-define=ADMIN_API_BASE_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# 3. AI Tutor, RAG Pipeline & Coding Sandbox
# ------------------------------------------------------------------------------
# Options: 'none', 'mock', 'openai', 'gemini' (runs deterministic fallback if API keys unset)
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.3
TUTOR_DAILY_RATE_LIMIT=100

RAG_MAX_FILE_SIZE_BYTES=10485760
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_MIN_SIMILARITY=0.15
RAG_TOP_K=3

# Coding Practice Sandbox ('false' = static analysis default; 'true' = isolated subprocess sandbox)
CODING_SANDBOX_ENABLED=false
CODING_EXECUTION_TIMEOUT_SECONDS=2.0

# ------------------------------------------------------------------------------
# 4. Preserved Legacy Python FastAPI Backend (backend/.env)
# ------------------------------------------------------------------------------
# Legacy backend remains isolated in backend/.env on port 8000 with SQLite/MySQL:
# DATABASE_URL=sqlite:///./skillbridge_dev.db
