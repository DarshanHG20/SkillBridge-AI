{
  "name": "skillbridge-ai-backend-node",
  "version": "1.0.0",
  "description": "SkillBridge AI enterprise-grade Node.js + Express + MongoDB backend with adaptive mastery modeling, RAG pipeline, AI tutor, and code practice sandbox.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit",
    "migrate:sql": "node scripts/migrate_sql_to_mongo.js",
    "seed": "node scripts/seed_mongo.js"
  },
  "keywords": [
    "skillbridge",
    "mern",
    "adaptive-learning",
    "ai-tutor",
    "rag",
    "express",
    "mongoose"
  ],
  "author": "SkillBridge AI Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true,
    "testTimeout": 30000
  }
}
