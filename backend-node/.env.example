# ==============================================================================
# SkillBridge AI - Node.js Express Backend Environment Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
API_V1_STR=/api/v1
PROJECT_NAME="SkillBridge AI"

# Security & Tokens
JWT_SECRET=replace_this_with_a_secure_minimum_32_characters_secret_key_skillbridge_2026
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=7

# MongoDB Database Connection
# In local development without MongoDB service, backend can auto-spin in-memory Mongo or connect to Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillbridge_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge_db
USE_MEMORY_DB_FALLBACK=true

# SQLite Source Database (for SQL-to-Mongo migration script)
SQLITE_DB_PATH=../backend/skillbridge_dev.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8080

# AI Tutor & Provider-Independent LLM Configuration
# Options: 'none', 'mock', 'openai', 'gemini'
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.3
TUTOR_DAILY_RATE_LIMIT=100

# RAG Pipeline Configuration
RAG_MAX_FILE_SIZE_BYTES=10485760
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_MIN_SIMILARITY=0.15
RAG_TOP_K=3

# Safe Coding Practice Sandbox
CODING_SANDBOX_ENABLED=false
CODING_EXECUTION_TIMEOUT_SECONDS=2.0
