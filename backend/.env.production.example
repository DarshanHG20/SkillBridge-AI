# ==============================================================================
# SkillBridge AI — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# 1. Never commit active credentials, production passwords, or secret keys to Git.
# 2. Copy this file to '.env' on your production server.
# 3. Generate strong random strings for all secrets (min 64 hex characters).
# ==============================================================================

PROJECT_NAME=SkillBridge AI
ENVIRONMENT=production
DEBUG=False

# ------------------------------------------------------------------------------
# Production Database Connection (Online Managed MySQL 8.0+)
# Example: mysql+pymysql://<user>:<password>@<db-host>:3306/<database>?ssl_ca=/path/to/ca.pem
# ------------------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://skillbridge_prod_user:CHANGE_ME_STRONG_DB_PASSWORD@mysql-prod.internal.yourdomain.com:3306/skillbridge_prod?charset=utf8mb4

# ------------------------------------------------------------------------------
# Security & Cryptography
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
SECRET_KEY=GENERATE_STRONG_RANDOM_64_CHAR_HEX_SECRET_KEY_FOR_JWT_SIGNING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# Explicit HTTPS domain allowlist. Never use '*' in production.
# ------------------------------------------------------------------------------
CORS_ORIGINS=["https://admin.yourdomain.com","https://app.yourdomain.com"]

# ------------------------------------------------------------------------------
# Rate Limiting & Abuse Prevention
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
DAILY_LLM_REQUEST_LIMIT_PER_USER=100

# ------------------------------------------------------------------------------
# AI Tutor & Knowledge Embedding Configuration
# Supported providers: gemini, openai, anthropic, or none (deterministic engine)
# ------------------------------------------------------------------------------
AI_PROVIDER=none
LLM_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash
EMBEDDING_PROVIDER=tfidf
EMBEDDING_API_KEY=

# RAG Knowledge Pipeline Paths
RAG_STORAGE_PATH=/var/lib/skillbridge/documents
VECTOR_INDEX_PATH=/var/lib/skillbridge/vector_index.pkl
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------------------------
# Logging & Monitoring
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
