# Backend specific .env file
# Copy to backend/.env or configure at project root
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="SkillBridge AI Backend"
API_V1_STR=/api/v1
SECRET_KEY=change_in_production_minimum_32_characters_secret_key_skillbridge_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite:///./skillbridge_dev.db
# For MySQL: mysql+pymysql://skillbridge_user:skillbridge_dev_pass@localhost:3306/skillbridge_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8080"]
HOST=0.0.0.0
PORT=8000

AI_ADAPTIVE_ENGINE_ENABLED=true
DEFAULT_MASTERY_THRESHOLD=0.75
MINIMUM_QUESTIONS_PER_ASSESSMENT=5
